# Copy this file to .env.local (gitignored) to override the API server.
#
# Default (no .env.local): points at the shared remote backend.
# Use the value below to test against your own local backend instead —
# needed for admin features, since the shared server has no admin account.
#
# Local backend setup:
#   1. cd backend && ./gradlew bootRun   (uses H2 in-memory DB)
#   2. Sign up an account via /api/auth/signup
#   3. Open http://localhost:8080/h2-console (JDBC URL: jdbc:h2:mem:cityfarm, user: sa, no password)
#   4. UPDATE users SET role_type = 'ADMIN' WHERE email = 'your@email.com';
#   5. Log in again on the frontend to pick up the new role

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
